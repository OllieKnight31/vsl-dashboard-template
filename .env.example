# Copy this file to .env and fill in the values. Never commit .env.

# Required: the ID of your Google Sheet (the part between /d/ and /edit in its URL)
SPREADSHEET_ID=

# Required: the whole Google service account JSON key, on one line
GOOGLE_SERVICE_ACCOUNT_KEY=

# Recommended: a shared secret the tracking snippet sends with each event
# (make one with: openssl rand -hex 16)
API_SECRET=

# Optional: the name and tagline shown at the top of the dashboard
BRAND_NAME=Your Brand
BRAND_TAGLINE=VSL Funnel Tracker

# Optional: leave empty for no login. Set it to require a password
# on the dashboard and on the read endpoints.
ACCESS_PASSWORD=

# Optional: Meta Ads sync (?action=sync_meta)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Optional: Calendly personal access token
CALENDLY_PAT=

# Optional: port for npm run dev
PORT=3000
